{
  "name": "vibe-snap",
  "version": "1.0.0",
  "description": "A modern, lightweight screenshot and annotation desktop application for Windows & macOS",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.vibesnap.app",
    "productName": "VibeSnap",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.jpg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VibeSnap"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "screenshot",
    "lightshot",
    "annotation",
    "utility",
    "electron"
  ],
  "author": "VibeCode",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
